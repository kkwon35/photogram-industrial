<!--<h1>-->
  <%#= @user.username %>
<!--</h1>-->

<!--<h2>Own photos</h2>-->

<div class="row mb-4">
  <div class="col-md-6 offset-md-3">
    <!-- Render the full profile info including avatar, follow/following/pending modals, bio, etc. -->
    <%= render "users/user", user: @user %>
  </div>
</div>

<!-- Nav tabs (Posts / Liked) -->
<div class="row mb-2">
  <div class="col-md-6 offset-md-3">
    <%= render "users/profile_nav", user: @user %>
  </div>
</div>

<!-- User's photos/posts -->
<% @user.own_photos.each do |photo| %>
  <%= render "photos/photo", photo: photo %>
<% end %>




