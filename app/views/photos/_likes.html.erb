<div class="d-flex align-items-center">
  <%= pluralize(photo.likes_count, "like") %>

  <% like = current_user.likes.find_by(photo: photo) %>

  <% if like %>
    <%= link_to like_path(like), method: :delete, class: "btn btn-link ms-2 text-muted link-underline-dark link-underline-opacity-0 link-underline-opacity-100-hover" do %>
      <i class="fas fa-heart fa-fw"></i>
      Un-like
    <% end %>
  <% else %>
    <%= form_with url: likes_path, method: :post, local: true, class: "ms-2 d-inline" do |form| %>
      <%= form.hidden_field :fan_id, value: current_user.id %>
      <%= form.hidden_field :photo_id, value: photo.id %>
      <%= form.button class: "btn btn-link text-muted link-underline-dark link-underline-opacity-0 link-underline-opacity-100-hover" do %>
        <i class="far fa-heart fa-fw"></i>
        Like
      <% end %>
    <% end %>
  <% end %>
</div>


